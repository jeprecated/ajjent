{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.24",
    "gopls@latest",
    "gotools@latest"
  ],
  "shell": {
    "scripts": {
      "fmt": [
        "go fmt ./..."
      ],
      "test": [
        "go test ./..."
      ],
      "build": [
        "mkdir -p ./bin",
        "go build -o ./bin/jjw ./"
      ],
      "install-local": [
        "mkdir -p \"$HOME/.local/bin\"",
        "go build -o \"$HOME/.local/bin/jjw\" ./"
      ]
    }
  }
}
